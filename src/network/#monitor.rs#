//! Aggregate rejected transports so floods cannot create one database write per packet.
use super::*;
/// Start bounded transport monitoring and aggregate security incidents.
pub(super) fn start(
    state: Arc<Mutex<State>>,
    stop: Arc<AtomicBool>,
    rejected: Arc<AtomicUsize>,
    timeouts: Arc<AtomicUsize>,
) -> thread::JoinHandle<()> {
    thread::spawn(move || {
        let mut failures = 0;
        while !stop.load(Ordering::Relaxed) {
            thread::sleep(Duration::from_millis(100));
            let expired = timeouts.swap(0, Ordering::Relaxed);
            if expired > 0 {
                if let Ok(state) = state.lock() {
                    let _ = crate::security::event(
                        &state.conn,
                        None,                        "request_timeout",
                        None,
                        expired as i64,
                    );
                    let _ = state.auth.flush_notifications(&state.conn);
                }
            }
            let count = rejected.swap(0, Ordering::Relaxed);
            if count == 0 {
                continue;
            }
            failures += count;
            if let Ok(state) = state.lock() {
                let (event, level) = if failures > 10 {
                    failures = 0;
                    ("tls_or_protocol_flood", 2)
                } else {
                    ("tls_or_protocol_rejected", 3)
                };
                let _ = services::audit(&state.conn, None, None, None, event, level);
                tracing::warn!(
                    target: "security",
                    event_type = event,
                    rejected_connections = count as u64,
                    severity = level,
                    "Network transport rejection aggregate"
                );
                let _ = state.auth.flush_notifications(&state.conn);
            }
        }
    })
}

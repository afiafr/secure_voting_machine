+    audit(
+        conn,
+        Some(election),
+        Some(session.user_id()),
+        None,
+        if received {
+            "pin_receipt_confirmed"
+        } else {
+            "pin_receipt_not_confirmed"
+        },
+        if received { 0 } else { 2 },
+    )
+}
